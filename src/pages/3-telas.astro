---
// src/pages/3-telas.astro - Silo Comercial 3 Telas
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Plano Cine VIP 3 Telas Simultâneas | Entretenimento para Toda a Família em 4K"
  description="Conheça o plano Cine VIP para 3 telas simultâneas. Libere Smart TV da sala, quarto dos filhos e celular ao mesmo tempo por apenas R$ 20/mês no plano anual."
  breadcrumbs={[
    { name: 'Início', url: '/' },
    { name: '3 Telas', url: '/3-telas/' }
  ]}
>
  <div class="py-16 sm:py-24 bg-[#030712]">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <span class="text-xs font-black text-amber-400 uppercase tracking-widest bg-amber-400/10 px-3 py-1 rounded-full border border-amber-500/20">
        Plano Familiar Completo
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mt-4 mb-6">
        Cine VIP para <span class="text-amber-400">3 Telas Simultâneas</span> Sem Bloqueio
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto mb-8 font-medium leading-relaxed">
        Três telas independentes funcionando ao mesmo tempo na mesma casa. Desenhos para as crianças, futebol ao vivo para os pais e séries para quem quiser.
      </p>

      <div class="bg-[#080d1a] border-2 border-amber-400 rounded-3xl p-8 max-w-lg mx-auto shadow-2xl shadow-amber-500/20 mb-8 relative">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-amber-400 to-yellow-400 text-slate-950 text-xs font-black uppercase tracking-wider">
          O Mais Vendido 🔥
        </div>
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-2 mt-2">No Plano Anual</span>
        <div class="flex items-baseline justify-center gap-1 mb-4">
          <span class="text-slate-400 text-sm">Apenas R$</span>
          <span class="text-5xl font-black text-white">20</span>
          <span class="text-slate-400 text-sm">,00 / mês</span>
        </div>
        <p class="text-xs text-slate-400 mb-6">Menos de R$ 7,00 por tela ao mês. O melhor custo-benefício do Brasil.</p>
        <a 
          href="/ir/3-telas/"
          class="w-full py-4 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-400 text-slate-950 font-black text-sm uppercase tracking-wider block shadow-lg hover:scale-105 transition-transform"
        >
          Pedir Teste Grátis 3 Telas
        </a>
      </div>
    </div>
  </div>
</Layout>
