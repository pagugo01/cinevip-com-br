---
// src/pages/contato.astro - Central de Atendimento Cine VIP
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config/site';
---

<Layout
  title="Contato & Suporte Oficial Cine VIP | Atendimento via WhatsApp"
  description="Fale com a equipe oficial do Cine VIP. Suporte técnico humanizado, liberação de teste gratuito de 6 horas e dúvidas pelo WhatsApp +55 (11) 97200-8717."
  breadcrumbs={[
    { name: 'Início', url: '/' },
    { name: 'Contato', url: '/contato/' }
  ]}
>
  <div class="py-16 bg-[#030712]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <div class="text-center mb-12">
        <span class="text-xs font-black text-amber-400 uppercase tracking-widest bg-amber-400/10 px-3 py-1 rounded-full border border-amber-500/20">
          Suporte 100% Humano
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mt-4">
          Fale com a Equipe <span class="text-amber-400">Cine VIP</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-300 mt-3 font-medium">
          Sem filas e sem robôs. Atendimento direto pelo nosso WhatsApp oficial.
        </p>
      </div>

      <div class="bg-[#080d1a] border border-amber-500/30 rounded-3xl p-8 max-w-lg mx-auto text-center shadow-xl shadow-amber-500/10 mb-8">
        <div class="w-16 h-16 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-4 text-2xl">
          💬
        </div>
        <h2 class="text-xl font-bold text-white mb-2">WhatsApp Oficial Cine VIP</h2>
        <p class="text-xs text-slate-400 mb-6">Atendimento todos os dias, das 08h às 23h.</p>
        <span class="text-2xl font-black text-amber-400 block mb-6">+55 (11) 97200-8717</span>
        <a 
          href="/ir/whatsapp/"
          class="w-full py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black text-sm uppercase tracking-wider block shadow-lg hover:scale-105 transition-transform"
        >
          Iniciar Conversa no WhatsApp
        </a>
      </div>

    </div>
  </div>
</Layout>

