---
// src/pages/teste-gratis.astro - Landing Page Oficial de Teste Grátis 6 Horas
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config/site';

const steps = [
  {
    step: '01',
    title: 'Clique e Chame no WhatsApp',
    desc: 'Sem formulários demorados. Fale direto com nossa equipe humana pelo número oficial +55 (11) 97200-8717.'
  },
  {
    step: '02',
    title: 'Receba seu Acesso em 2 Minutos',
    desc: 'Enviamos seu usuário, senha e o link direto para o aplicativo ideal da sua Smart TV ou celular.'
  },
  {
    step: '03',
    title: 'Assista por 6 Horas Sem Compromisso',
    desc: 'Teste todos os canais ao vivo, futebol, filmes e séries em 4K nativo no conforto da sua casa.'
  }
];
---

<Layout
  title="Teste VIP Grátis de 6 Horas pelo WhatsApp sem Cartão | Cine VIP"
  description="Solicite seu teste gratuito de 6 horas do Cine VIP pelo WhatsApp +55 (11) 97200-8717. Sem cartão de crédito, sem fidelidade e com ativação imediata em 2 minutos."
  breadcrumbs={[
    { name: 'Início', url: '/' },
    { name: 'Teste Grátis', url: '/teste-gratis/' }
  ]}
>
  <div class="py-16 sm:py-24 bg-gradient-to-b from-[#080d1a] via-[#030712] to-[#030712]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Teste 100% Gratuito sem Cartão</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-tight mb-6">
        Teste VIP de <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-amber-300 to-yellow-400">6 Horas Grátis</span>: Do pedido ao primeiro canal na sua TV
      </h1>

      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto mb-10 font-medium leading-relaxed">
        Comprove a qualidade e a estabilidade do Cine VIP antes de colocar a mão no bolso. Sem pegadinhas, sem assinatura automática e com suporte humano via WhatsApp.
      </p>

      <a 
        href="/ir/teste-gratis/"
        class="inline-flex items-center gap-3 px-8 py-4 sm:py-5 rounded-2xl bg-gradient-to-r from-emerald-500 via-teal-500 to-emerald-400 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black text-sm sm:text-base uppercase tracking-wider shadow-xl shadow-emerald-500/25 hover:scale-105 transition-all duration-200"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.072.043.419-.101.824z"/>
        </svg>
        <span>Solicitar Teste VIP no WhatsApp Agora</span>
      </a>

      <!-- 3 Passos -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-16 text-left">
        {steps.map((s) => (
          <div class="bg-[#080d1a] border border-slate-800 rounded-2xl p-6 relative">
            <span class="text-3xl font-black text-emerald-400/40 block mb-2">{s.step}</span>
            <h3 class="text-base font-bold text-white mb-2">{s.title}</h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>
